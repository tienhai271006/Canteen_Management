generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────── Enums ─────────────────────────

enum Role {
  CUSTOMER
  VENDOR // thành viên của ít nhất một quầy (quyền chi tiết nằm ở VendorStaff)
  ADMIN
}

enum UserStatus {
  ACTIVE
  LOCKED
}

enum VendorStatus {
  PENDING_APPROVAL
  ACTIVE
  REJECTED
  SUSPENDED
}

enum VendorType {
  CANTEEN_STALL // quầy trong canteen / nhà ăn
  FOOD_SHED // lán bán đồ ăn quanh trường
}

enum VendorRole {
  MANAGER
  STAFF
}

enum DishStatus {
  ACTIVE
  HIDDEN
  DISCONTINUED
}

// Thứ tự khai báo = thứ tự sắp xếp khi ORDER BY
enum SessionType {
  BREAKFAST
  LUNCH
  DINNER
}

enum QuotaAdjustmentType {
  SET_ONLINE
  SET_WALKIN
  TRANSFER_TO_WALKIN
  TRANSFER_TO_ONLINE
  RESOLD
  WASTED
}

// ───────────────────────── UC1: Tài khoản ─────────────────────────

model User {
  id              String     @id @default(uuid())
  email           String     @unique
  passwordHash    String
  fullName        String
  studentCode     String?
  className       String?
  phone           String?
  role            Role       @default(CUSTOMER)
  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?
  tokenVersion    Int        @default(0) // tăng khi đăng xuất / đổi mật khẩu để thu hồi token cũ
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  verifications   EmailVerification[]
  vendorStaff     VendorStaff[]
  approvedVendors Vendor[]            @relation("VendorApprover")
  quotaActions    QuotaAdjustment[]
}

model EmailVerification {
  id        String    @id @default(uuid())
  userId    String
  email     String // email đang được xác minh (có thể là email mới khi đổi email)
  codeHash  String
  expiresAt DateTime
  attempts  Int       @default(0)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// Dùng cho middleware idempotency (BR36): cùng Idempotency-Key gửi lại thì trả kết quả cũ
model IdempotencyKey {
  id             String   @id @default(uuid())
  userId         String
  key            String
  scope          String
  responseStatus Int?
  responseBody   Json?
  createdAt      DateTime @default(now())

  @@unique([userId, key])
  @@index([createdAt])
}

// ───────────────────────── UC2: Điểm bán ─────────────────────────

model Area {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())

  vendors Vendor[]
}

model Vendor {
  id              String       @id @default(uuid())
  areaId          String
  name            String
  type            VendorType
  description     String?
  pickupLocation  String // địa điểm nhận món
  openTime        String // "HH:mm"
  closeTime       String // "HH:mm"
  contactPhone    String?
  status          VendorStatus @default(PENDING_APPROVAL)
  rejectionReason String?
  suspendedReason String?
  approvedAt      DateTime?
  approvedById    String?
  suspendedAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  area       Area             @relation(fields: [areaId], references: [id])
  approvedBy User?            @relation("VendorApprover", fields: [approvedById], references: [id])
  staff      VendorStaff[]
  dishes     Dish[]
  sessions   ServiceSession[]
  menuItems  MenuItem[]

  @@unique([areaId, name])
  @@index([areaId, status])
}

model VendorStaff {
  id        String     @id @default(uuid())
  vendorId  String
  userId    String
  role      VendorRole
  createdAt DateTime   @default(now())

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([vendorId, userId])
  @@index([userId])
}

// ───────────────────────── UC3: Món ăn & thực đơn ─────────────────────────

model Dish {
  id          String     @id @default(uuid())
  vendorId    String
  name        String
  description String?
  imageUrl    String?
  category    String
  price       Int // VND, giá hiện hành (đơn hàng sẽ chụp lại giá khi tạo - BR04)
  status      DishStatus @default(ACTIVE)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  vendor    Vendor     @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  menuItems MenuItem[]

  @@index([vendorId, status])
}

// Ca phục vụ của quầy: sáng / trưa / chiều
model ServiceSession {
  id          String      @id @default(uuid())
  vendorId    String
  session     SessionType
  startTime   String // "HH:mm" bắt đầu ca
  endTime     String // "HH:mm" kết thúc ca
  orderCutoff String // "HH:mm" giờ đóng nhận đơn (BR02)
  prepMinutes Int         @default(15) // thời gian quầy cần chuẩn bị tối thiểu
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  vendor Vendor       @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  slots  PickupSlot[]

  @@unique([vendorId, session])
}

// Khung nhận món. Không xóa cứng vì đơn cũ có thể tham chiếu → dùng isActive.
model PickupSlot {
  id        String  @id @default(uuid())
  sessionId String
  startTime String
  endTime   String
  isActive  Boolean @default(true)

  session ServiceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, startTime])
}

// Món được bán trong một ngày + một ca của quầy
model MenuItem {
  id        String      @id @default(uuid())
  vendorId  String
  dishId    String
  date      DateTime    @db.Date
  session   SessionType
  createdAt DateTime    @default(now())

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  dish   Dish   @relation(fields: [dishId], references: [id])
  quota  Quota?

  @@unique([dishId, date, session])
  @@index([vendorId, date, session])
}

// Hạn mức suất. Số còn đặt được = onlineTotal - reserved - sold
//   reserved: suất đang giữ bởi đơn chưa hoàn tất (Pending → Ready)
//   sold:     suất của đơn đã Completed
//   walkInTotal: phần dành cho khách mua tại quầy, tách khỏi online (BR33)
model Quota {
  id          String   @id @default(uuid())
  menuItemId  String   @unique
  onlineTotal Int      @default(0)
  walkInTotal Int      @default(0)
  reserved    Int      @default(0)
  sold        Int      @default(0)
  resold      Int      @default(0)
  wasted      Int      @default(0)
  createdAt   DateTime @default(now())

  menuItem    MenuItem          @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  adjustments QuotaAdjustment[]
}

// Lịch sử điều chỉnh hạn mức: ai, khi nào, vì sao (NFR03)
model QuotaAdjustment {
  id        String              @id @default(uuid())
  quotaId   String
  type      QuotaAdjustmentType
  quantity  Int // SET_*: chênh lệch (có thể âm); còn lại: số lượng dương
  reason    String?
  actorId   String
  createdAt DateTime            @default(now())

  quota Quota @relation(fields: [quotaId], references: [id], onDelete: Cascade)
  actor User  @relation(fields: [actorId], references: [id])

  @@index([quotaId, createdAt])
}
