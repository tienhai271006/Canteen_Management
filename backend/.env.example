NODE_ENV=development
PORT=4000
TZ=Asia/Ho_Chi_Minh

# PostgreSQL (khớp với docker-compose / lệnh docker run trong README)
DATABASE_URL=postgresql://canteen:canteen@localhost:5432/canteen?schema=public

# Đổi thành chuỗi ngẫu nhiên dài (>= 16 ký tự) khi triển khai
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d
CORS_ORIGIN=http://localhost:5173

# Email trường (dùng để đánh dấu isSchoolEmail)
SCHOOL_EMAIL_DOMAIN=phenikaa-uni.edu.vn

# OTP xác minh email
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5

# Để trống SMTP_HOST thì OTP được in ra console (tiện khi dev)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Canteen Phenikaa <no-reply@canteen.local>"

# Tham số nghiệp vụ (dùng ở module orders/jobs)
PENDING_TTL_MINUTES=5
PICKUP_WAIT_MINUTES=15
